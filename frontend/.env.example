# Required in production. A production build with this unset throws a clear
# error on load rather than silently calling localhost. Dev falls back to
# http://localhost:5000. Must be https:// in production (Vercel is https, and
# a scheme-less value is treated by axios as a path on the current origin).
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Landing-page figures (prices, timelines, GIPC thresholds, company trust
# signals, legal links) are NO LONGER set here. They moved to runtime platform
# settings, editable by an admin in the ops console under Settings -> Landing
# page, and served at GET /public/landing-config. Change them there; no
# redeploy needed. Only the two infra URLs above are build-time env vars, and
# they are PUBLIC (baked into the bundle) - never put a secret in a VITE_ var.
# ---------------------------------------------------------------------------
