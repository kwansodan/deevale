# Reverse proxy for the Deevale GH API, used by the caddy service in
# docker-compose.prod.yml. The hostname comes from API_DOMAIN in .env so the
# same file works across environments.
#
# Caddy provisions and renews the TLS certificate for this domain automatically
# (Let's Encrypt), and proxies WebSocket upgrades for /socket.io/ as-is. It
# reaches the app by its compose service name, api:8000, over the internal
# network -- not the host's 127.0.0.1.
{$API_DOMAIN} {
	reverse_proxy api:8000
}
