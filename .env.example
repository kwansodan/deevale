# WARNING: a literal $ in any value below is read by Docker Compose as a
# variable reference and silently replaced with an empty string, so the app
# receives a truncated secret. Either escape it as $$ or, better, generate
# secrets with `openssl rand -hex 32` -- hex output cannot contain $.

FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# The public hostname the caddy service answers on and provisions a TLS cert
# for. Must already resolve (DNS A record) to this server before deploy, or the
# Let's Encrypt challenge fails.
API_DOMAIN=api.deevalegh.com

DATABASE_URL=postgresql+psycopg2://deevalegh:deevalegh@localhost:5432/deevalegh
TEST_DATABASE_URL=postgresql+psycopg2://deevalegh:deevalegh@localhost:5432/deevalegh_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

S3_ENDPOINT_URL=http://localhost:9000
# Browser-reachable public endpoint used only for presigned upload/download
# URLs. In prod set this to the HTTPS domain the caddy service proxies to MinIO
# (FILES_DOMAIN below), e.g. https://files.deevalegh.com. In dev, leave it as
# the localhost endpoint. Presigning against the internal minio:9000 produced
# links the browser could not load (mixed content).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=deevalegh
S3_SECRET_KEY=deevalegh-secret
S3_BUCKET=deevalegh-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# Public hostname the caddy service serves and proxies to MinIO. Must resolve
# (DNS A record) to this host before deploy so its TLS cert can be issued.
FILES_DOMAIN=files.deevalegh.com

OTP_SENDER=console
EMAIL_SENDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@deevalegh.com

PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co

CORS_ORIGINS=http://localhost:5173
